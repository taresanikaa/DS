# Copy to .env for local overrides. Do not put real credentials here.
NODE_ENV=production
PORT=3000
SQLITE_DB_PATH=/app/data/upi_simulator.db

MAX_RETRIES=2
RETRY_DELAY_SECONDS=0.4
REQUEST_TIMEOUT_SECONDS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=10
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1

# Optional service URLs used by some educational views. Same-origin defaults apply when empty.
NPCI_GRPC_URL=
NPCI_URL=
RABBITMQ_URL=
RECEIVER_BANK_GRPC_URL=
RECEIVER_BANK_PEER_URL=
RECEIVER_BANK_URL=
SENDER_BANK_GRPC_URL=
SENDER_BANK_URL=
VITE_NPCI_URL=
VITE_RECEIVER_BANK_URL=
VITE_SENDER_BANK_URL=
VITE_TXN_API_URL=
VITE_TXN_WS_URL=

# Reserved placeholders. The current Node server does not read these keys.
UPI_HMAC_SECRET=change-me
UPI_API_TOKEN=change-me
DB_ENCRYPTION_KEY=change-me
